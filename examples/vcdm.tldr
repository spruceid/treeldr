prefix cred = <https://www.w3.org/2018/credentials#>
prefix schema = <https://schema.org/>

## VCDM 2.0 layout.
let (_ credential subject) where {
		credential cred:credentialSubject subject
} = {
	## Issuer.
	"issuer" = let issuer where {
		credential cred:issuer issuer
	}; (iri_of issuer),

	## Credential subject.
	"credentialSubject" = {
		## Identifier.
		"id" = (iri_of subject),

		## Name.
		"name" = let name where {
			subject schema:name name
		}; (string_of name)
	}
}